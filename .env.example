# Copy to .env and fill in. Never commit .env.

# --- Sarvam AI (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v4-flash

# --- Flagsmith (self-hosted, UI at http://localhost:8000) ---
# Create a project + environment in the UI, then copy the Server-side Environment Key.
FLAGSMITH_API_URL=http://localhost:8000/api/v1/
FLAGSMITH_ENVIRONMENT_KEY=
# Only for scripts/seed_flagsmith.py (creates the flags). The app itself never uses it.
FLAGSMITH_ADMIN_KEY=

# --- NudgeBee (self-hosted Community, UI at http://localhost:3000) ---
# Admin > Integrations > Automation Webhook; URL looks like http://localhost:3000/api/webhooks/workflow?token=...
NUDGEBEE_WEBHOOK_URL=
# NudgeBee's HTTP task blocks private IPs, so it must call us through a PUBLIC tunnel URL.
PUBLIC_API_BASE_URL=
# Bearer token NudgeBee sends when calling back. Any long random string.
WORKFLOW_API_TOKEN=

# --- App ---
# Shown on the owner screen. Change it for the festival you are in: Diwali, Eid, Christmas, Pongal...
FESTIVE_SEASON=Navratri / Garba season
APP_PORT=8200
DB_PATH=garba.db

# --- Ingest API (Store Connectors: Shopify, etc.) ---
# Bearer token required for POST /api/ingest/products and POST /api/ingest/orders.
INGEST_API_TOKEN=

# --- Shopify Dev Store Integration ---
# Your Shopify store domain (e.g. your-store.myshopify.com)
SHOPIFY_SHOP_DOMAIN=
# Custom app Admin API access token (scopes: read_products, read_orders, write_orders)
SHOPIFY_ACCESS_TOKEN=
